# Copy to backend/.env and fill in. backend/.env is git-ignored; never commit real values.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Neon Postgres (plan 4). Paste the direct (not pooled) connection string exactly as Neon shows it; the backend
# switches it to the asyncpg driver and always verifies TLS.
# DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/paymentsapp?sslmode=require&channel_binding=require
# Disposable database for tests. Its name must end in _test, and it is wiped on every test run.
# TEST_DATABASE_URL=postgresql://ROLE:PASSWORD@HOST/paymentsapp_test?sslmode=require&channel_binding=require

# Field encryption keys (plan 7.3): "k1=<base64>[,k0=<old key>]". The first key encrypts; all of them decrypt.
# Generate one with: uv run python -m paymentsapp.cli generate-encryption-key
# Losing the key makes encrypted fields (such as admin TOTP secrets) unreadable, so back it up.
FIELD_ENCRYPTION_KEYS=

# Admin website sign-in. false skips the authenticator code, for local demos; ignored outside development.
ADMIN_TOTP_REQUIRED=true

# Admin website: JSON list of networks (CIDRs) allowed to reach /admin. Empty allows all outside production.
# ADMIN_IP_ALLOWLIST=["203.0.113.0/24"]

# Mock bank (plan 9.2). The API key and webhook secret are printed once by its create-client command.
MOCKBANK_BASE_URL=https://mockbankforpayments.onrender.com
MOCKBANK_API_KEY=
MOCKBANK_WEBHOOK_SECRET=
MOCKBANK_ESCROW_UPI_ID=
MOCKBANK_OPERATING_UPI_ID=

# Contract tests only: an ordinary test customer's UPI ID on the mock bank.
MOCKBANK_TEST_CUSTOMER_UPI_ID=
# Set to true to also run the contract test that pays 1 rupee from the operating account.
# MOCKBANK_CONTRACT_MOVE_MONEY=false
